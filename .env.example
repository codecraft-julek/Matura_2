# The website itself needs NO environment variables:
#  - public Supabase values (URL) live in src/config/site.ts
#  - all secrets live in Supabase as Edge Function secrets (Dashboard → Edge Functions → Secrets)
#
# This file is only for the Supabase CLI on your computer. Copy it to .env.local (never commit that).

# Database password of the "Matura" project. Needed for `supabase db push`.
SUPABASE_DB_PASSWORD=
